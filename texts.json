{
  // Texts of DiceKingdoms Upkeep: English is needed, other languages fall back to it. Languages: en, de, fr, ru, uk, zh-CN.
  // A file <DllName>.texts.json next to the DLL wins line by line, so players can fix or add texts without rebuilding.
  // rule.<key>.title / .description translate lobby rules (ModCore).
  "group.upkeep.title": { "en": "Upkeep", "de": "Unterhalt", "fr": "Entretien", "ru": "Содержание", "uk": "Утримання", "zh-CN": "维护费" },
  "rule.upkeep.on.title": { "en": "Upkeep", "de": "Unterhalt", "fr": "Entretien", "ru": "Содержание", "uk": "Утримання", "zh-CN": "维护费" },
  "rule.upkeep.on.description": {
    "en": "Guard towers eat food and lighthouses use wood or stone every turn; unpaid ones do not shoot, and unpaid lighthouses give no fish bonus. Each player chooses what to pay in the Upkeep window; a choice counts from the next turn.",
    "de": "Wachtürme essen Nahrung und Leuchttürme verbrauchen jede Runde Holz oder Stein; unbezahlte schießen nicht, und unbezahlte Leuchttürme geben keinen Fischbonus. Jeder Spieler wählt im Unterhalt-Fenster, was er bezahlt; eine Wahl gilt ab der nächsten Runde.",
    "fr": "Les tours de garde mangent de la nourriture et les phares utilisent du bois ou de la pierre à chaque tour ; ceux qui ne sont pas payés ne tirent pas, et les phares non payés ne donnent pas de bonus de pêche. Chaque joueur choisit ce qu'il paie dans la fenêtre Entretien ; un choix compte à partir du tour suivant.",
    "ru": "Сторожевые башни едят еду, а маяки каждый ход тратят дерево или камень; неоплаченные не стреляют, а неоплаченные маяки не дают бонуса к рыбе. Каждый игрок выбирает, что оплачивать, в окне «Содержание»; выбор действует со следующего хода.",
    "uk": "Сторожові вежі їдять їжу, а маяки щоходу витрачають дерево або камінь; неоплачені не стріляють, а неоплачені маяки не дають бонусу до риби. Кожен гравець вибирає, що оплачувати, у вікні «Утримання»; вибір діє з наступного ходу.",
    "zh-CN": "哨塔每回合消耗食物，灯塔每回合消耗木材或石头；未支付的不会射击，未支付的灯塔也不提供渔业加成。每位玩家在“维护费”窗口中选择支付哪些；选择从下一回合起生效。"
  },
  "rule.upkeep.towerFood.title": { "en": "Food per guard tower", "de": "Nahrung pro Wachturm", "fr": "Nourriture par tour de garde", "ru": "Еда на сторожевую башню", "uk": "Їжа на сторожову вежу", "zh-CN": "每座哨塔的食物" },
  "rule.upkeep.towerFood.description": { "en": "Food each guard tower eats per turn.", "de": "Nahrung, die jeder Wachturm pro Runde isst.", "fr": "Nourriture que chaque tour de garde mange par tour.", "ru": "Сколько еды каждая сторожевая башня съедает за ход.", "uk": "Скільки їжі кожна сторожова вежа з'їдає за хід.", "zh-CN": "每座哨塔每回合消耗的食物。" },
  "rule.upkeep.lighthouseCost.title": { "en": "Wood or stone per lighthouse", "de": "Holz oder Stein pro Leuchtturm", "fr": "Bois ou pierre par phare", "ru": "Дерево или камень на маяк", "uk": "Дерево або камінь на маяк", "zh-CN": "每座灯塔的木材或石头" },
  "rule.upkeep.lighthouseCost.description": { "en": "Wood or stone (whichever there is more of) each lighthouse uses per turn.", "de": "Holz oder Stein (wovon mehr da ist), das jeder Leuchtturm pro Runde verbraucht.", "fr": "Bois ou pierre (celui dont il y a le plus) que chaque phare utilise par tour.", "ru": "Дерево или камень (чего больше), которое каждый маяк тратит за ход.", "uk": "Дерево або камінь (чого більше), яке кожен маяк витрачає за хід.", "zh-CN": "每座灯塔每回合消耗的木材或石头（取较多的一种）。" },
  "rule.upkeep.offerGold.title": { "en": "Cathedral offering (gold)", "de": "Kathedralen-Opfergabe (Gold)", "fr": "Offrande à la cathédrale (or)", "ru": "Подношение в соборе (золото)", "uk": "Пожертва в соборі (золото)", "zh-CN": "大教堂供奉（金币）" },
  "rule.upkeep.offerGold.description": { "en": "Gold per Cathedral for an offering, which doubles its culture at the next harvest.", "de": "Gold pro Kathedrale für eine Opfergabe, die ihre Kultur bei der nächsten Ernte verdoppelt.", "fr": "Or par cathédrale pour une offrande, qui double sa culture à la prochaine récolte.", "ru": "Золото за каждый собор для подношения, которое удваивает его культуру при следующем сборе урожая.", "uk": "Золото за кожен собор для пожертви, яка подвоює його культуру під час наступного збору врожаю.", "zh-CN": "每座大教堂供奉所需的金币，供奉使其在下一次收获时文化翻倍。" },

  "panel.tooltip": { "en": "Upkeep", "de": "Unterhalt", "fr": "Entretien", "ru": "Содержание", "uk": "Утримання", "zh-CN": "维护费" },
  "panel.title": { "en": "Upkeep", "de": "Unterhalt", "fr": "Entretien", "ru": "Содержание", "uk": "Утримання", "zh-CN": "维护费" },
  "panel.help": { "en": "Paid in the disasters phase. A change counts from the next turn.", "de": "Bezahlt in der Katastrophenphase. Eine Änderung gilt ab der nächsten Runde.", "fr": "Payé pendant la phase des catastrophes. Un changement compte à partir du tour suivant.", "ru": "Оплачивается в фазе бедствий. Изменение действует со следующего хода.", "uk": "Сплачується у фазі лих. Зміна діє з наступного ходу.", "zh-CN": "在灾难阶段支付。更改从下一回合起生效。" },
  "panel.payTowers": { "en": "Feed the guard towers ({0} food each)", "de": "Wachtürme versorgen (je {0} Nahrung)", "fr": "Nourrir les tours de garde ({0} nourriture chacune)", "ru": "Кормить сторожевые башни ({0} еды каждой)", "uk": "Годувати сторожові вежі ({0} їжі кожній)", "zh-CN": "供养哨塔（每座 {0} 食物）" },
  "panel.payLighthouses": { "en": "Pay the lighthouses ({0} wood or stone each)", "de": "Leuchttürme bezahlen (je {0} Holz oder Stein)", "fr": "Payer les phares ({0} bois ou pierre chacun)", "ru": "Оплачивать маяки ({0} дерева или камня каждый)", "uk": "Оплачувати маяки ({0} дерева або каменю кожен)", "zh-CN": "支付灯塔（每座 {0} 木材或石头）" },
  "panel.towersFirst": { "en": "Guard towers eat before the houses", "de": "Wachtürme essen vor den Häusern", "fr": "Les tours de garde mangent avant les maisons", "ru": "Сторожевые башни едят раньше домов", "uk": "Сторожові вежі їдять раніше за будинки", "zh-CN": "哨塔先于房屋进食" },
  "panel.offer": { "en": "Make an offering", "de": "Opfergabe bringen", "fr": "Faire une offrande", "ru": "Сделать подношение", "uk": "Зробити пожертву", "zh-CN": "进行供奉" },
  "panel.offerHelp": { "en": "Offering: {0} gold per Cathedral ({1}) doubles their culture at the next harvest. Build phase only, once per turn.", "de": "Opfergabe: {0} Gold pro Kathedrale ({1}) verdoppelt ihre Kultur bei der nächsten Ernte. Nur in der Bauphase, einmal pro Runde.", "fr": "Offrande : {0} or par cathédrale ({1}) double leur culture à la prochaine récolte. Seulement en phase de construction, une fois par tour.", "ru": "Подношение: {0} золота за собор ({1}) удваивает их культуру при следующем сборе урожая. Только в фазе строительства, раз за ход.", "uk": "Пожертва: {0} золота за собор ({1}) подвоює їхню культуру під час наступного збору врожаю. Лише у фазі будівництва, раз на хід.", "zh-CN": "供奉：每座大教堂（{1} 座）{0} 金币，使其在下一次收获时文化翻倍。仅限建造阶段，每回合一次。" },
  "panel.offered": { "en": "Offering made at {0} of {1} Cathedral(s): their culture is doubled at the next harvest.", "de": "Opfergabe an {0} von {1} Kathedrale(n) gebracht: ihre Kultur wird bei der nächsten Ernte verdoppelt.", "fr": "Offrande faite à {0} cathédrale(s) sur {1} : leur culture est doublée à la prochaine récolte.", "ru": "Подношение сделано в соборах: {0} из {1}. Их культура удвоится при следующем сборе урожая.", "uk": "Пожертву зроблено в соборах: {0} з {1}. Їхня культура подвоїться під час наступного збору врожаю.", "zh-CN": "已在 {1} 座大教堂中的 {0} 座供奉：下一次收获时其文化翻倍。" },
  "panel.noCathedral": { "en": "No Cathedral yet: nothing to offer at.", "de": "Noch keine Kathedrale: keine Opfergabe möglich.", "fr": "Pas encore de cathédrale : rien où faire une offrande.", "ru": "Собора пока нет: подношение сделать негде.", "uk": "Собору ще немає: пожертву зробити ніде.", "zh-CN": "还没有大教堂：无处供奉。" },
  "panel.allPaid": { "en": "This turn: everything paid.", "de": "Diese Runde: alles bezahlt.", "fr": "Ce tour : tout est payé.", "ru": "Этот ход: всё оплачено.", "uk": "Цей хід: усе оплачено.", "zh-CN": "本回合：全部已支付。" },
  "panel.unpaid": { "en": "This turn unpaid: {0} guard tower(s), {1} lighthouse(s). They do not shoot.", "de": "Diese Runde unbezahlt: {0} Wachturm/-türme, {1} Leuchtturm/-türme. Sie schießen nicht.", "fr": "Non payé ce tour : {0} tour(s) de garde, {1} phare(s). Ils ne tirent pas.", "ru": "Не оплачено в этот ход: сторожевых башен {0}, маяков {1}. Они не стреляют.", "uk": "Не оплачено цього ходу: сторожових веж {0}, маяків {1}. Вони не стріляють.", "zh-CN": "本回合未支付：哨塔 {0} 座，灯塔 {1} 座。它们不会射击。" },
  "panel.fromNextTurn": { "en": "This turn's upkeep is paid in the disasters phase.", "de": "Der Unterhalt dieser Runde wird in der Katastrophenphase bezahlt.", "fr": "L'entretien de ce tour est payé pendant la phase des catastrophes.", "ru": "Содержание за этот ход оплачивается в фазе бедствий.", "uk": "Утримання за цей хід сплачується у фазі лих.", "zh-CN": "本回合的维护费在灾难阶段支付。" }
